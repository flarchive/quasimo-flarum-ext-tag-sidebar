{
    "name": "quasimo/flarum-ext-tag-sidebar",
    "description": "Customize sidebar content and description for specific Flarum tag pages",
    "type": "flarum-extension",
    "license": "MIT",
    "keywords": ["flarum", "extension", "tag", "sidebar", "custom", "description"],
    "homepage": "https://github.com/Quasimo/flarum-ext-tag-sidebar",
    "support": {
        "issues": "https://github.com/Quasimo/flarum-ext-tag-sidebar/issues",
        "source": "https://github.com/Quasimo/flarum-ext-tag-sidebar"
    },
    "authors": [
        {
            "name": "Quasimo",
            "homepage": "https://github.com/Quasimo"
        }
    ],
    "require": {
        "flarum/core": "^1.8",
        "flarum/tags": "*"
    },
    "autoload": {
        "psr-4": {
            "Quasimo\\TagSidebar\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Tag Sidebar Customizer",
            "category": "feature",
            "icon": {
                "name": "fas fa-tags",
                "backgroundColor": "#0EA5E9",
                "color": "#ffffff"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
